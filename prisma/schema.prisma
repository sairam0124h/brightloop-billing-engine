generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum SubscriptionStatus {
  DRAFT
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  RENEWED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Sequence {
  id                     String @id @default("default")
  nextInvoiceNumber      Int    @default(1)
  nextSubscriptionNumber Int    @default(1000)
}

model User {
  id                   String          @id @default(uuid())
  email                String          @unique
  passwordHash         String
  role                 UserRole        @default(CUSTOMER)
  name                 String?
  phone                String?
  defaultCurrency      String          @default("INR")
  taxCode              String?
  mustResetPassword    Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  passwordResetTokens  PasswordResetToken[]
  subscriptions        Subscription[]
  payments             Payment[]
  audits               AuditLog[]

  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tokenHash])
  @@index([expiresAt])
}

model Product {
  id            String   @id @default(uuid())
  name          String
  description   String?
  sku           String?  @unique
  unitPrice     Int
  taxCode       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  variants      ProductVariant[]
  discounts     Discount[] @relation("product_discounts")

  @@index([sku])
}

model ProductVariant {
  id          String   @id @default(uuid())
  productId   String
  attribute   String
  value       String
  extraPrice  Int      @default(0)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, attribute, value])
}

model Plan {
  id                String           @id @default(uuid())
  name              String
  description       String?
  price             Int
  billingInterval   String
  minQuantity       Int              @default(1)
  startDate         DateTime         @default(now())
  endDate           DateTime?
  autoClose         Boolean          @default(false)
  closable          Boolean          @default(true)
  pausable          Boolean          @default(true)
  renewable         Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  subscriptions     Subscription[]

  @@index([startDate])
}

model QuotationTemplate {
  id          String          @id @default(uuid())
  name        String
  description String?
  validDays   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lines       QuotationLine[]
}

model QuotationLine {
  id                 String          @id @default(uuid())
  templateId         String
  productId          String?
  productVariantId    String?
  quantity           Int
  unitPrice          Int
  taxCode            String?
  discountType       String?
  discountValue      Int?
  totalPrice         Int
  template           QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model Subscription {
  id                  String              @id @default(uuid())
  number              Int
  customerId          String
  planId              String
  startDate           DateTime
  expiryDate          DateTime?
  status              SubscriptionStatus  @default(DRAFT)
  paymentTerms        Int
  nextBillingDate     DateTime?
  quotationExpiresAt  DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  customer            User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan                Plan      @relation(fields: [planId], references: [id])
  lines               SubscriptionLine[]
  invoices            Invoice[]

  @@unique([number])
  @@index([customerId])
  @@index([status])
}

model SubscriptionLine {
  id               String      @id @default(uuid())
  subscriptionId   String
  productId        String?
  productVariantId  String?
  quantity         Int
  unitPrice        Int
  discountAmount   Int
  taxAmount         Int
  totalAmount      Int
  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

model Tax {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  rate      Decimal
  createdAt DateTime @default(now())

  @@index([code])
}

model Discount {
  id            String    @id @default(uuid())
  type          String
  value         Int
  minPurchase   Int
  minQuantity   Int
  startDate     DateTime
  endDate       DateTime?
  usageLimit    Int?
  usedCount     Int       @default(0)
  appliesTo     String
  productId     String?
  product       Product? @relation("product_discounts", fields: [productId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([startDate])
}

model Invoice {
  id                  String        @id @default(uuid())
  number              Int
  subscriptionId      String
  status              InvoiceStatus @default(DRAFT)
  subtotal            Int
  discountTotal       Int
  taxTotal            Int
  total               Int
  sentAt              DateTime?
  lastReminderAt      DateTime?
  reminderCount       Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  subscription        Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  lines               InvoiceLine[]
  payments            Payment[]

  @@unique([number])
  @@unique([subscriptionId, status])
  @@index([status])
  @@index([sentAt])
}

model InvoiceLine {
  id          String   @id @default(uuid())
  invoiceId  String
  productId  String?
  taxCode    String?
  quantity   Int
  unitPrice  Int
  discount   Int
  tax        Int
  total      Int
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id              String    @id @default(uuid())
  invoiceId       String
  method          String
  amount          Int
  paidAt          DateTime
  note            String?
  recordedById    String
  idempotencyKey  String    @unique
  createdAt       DateTime  @default(now())

  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy      User     @relation(fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([paidAt])
}

model BillingRun {
  id         String   @id @default(uuid())
  startDate  DateTime
  endDate    DateTime?
  stats      Json
  errors     Json
  createdAt  DateTime @default(now())
}

model AuditLog {
  id          String    @id @default(uuid())
  entity      String
  entityId    String
  action      String
  details     Json
  performedBy String?
  performedAt DateTime @default(now())
  user        User?    @relation(fields: [performedBy], references: [id])

  @@index([entity, entityId])
}

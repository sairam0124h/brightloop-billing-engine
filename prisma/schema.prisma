generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

model Sequence {
  id                     String @id @default("default")
  nextInvoiceNumber      Int    @default(1)
  nextSubscriptionNumber Int    @default(1000)
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  role                UserRole             @default(CUSTOMER)
  name                String?
  phone               String?
  defaultCurrency     String               @default("INR")
  taxCode             String?
  mustResetPassword   Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordResetTokens PasswordResetToken[]
  subscriptions       Subscription[]
  payments            Payment[]
  audits              AuditLog[]

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tokenHash])
  @@index([expiresAt])
}

model Product {
  id             String           @id @default(uuid())
  name           String
  type           String           @default("SERVICE")
  salesPrice     Int              @default(0)
  costPrice      Int              @default(0)
  unitPrice      Int              @default(0)
  notes          String?
  description    String?
  sku            String?          @unique
  taxCode        String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  variants       ProductVariant[]
  discounts      Discount[]       @relation("product_discounts")
  quotationLines QuotationLine[]

  @@index([sku])
}

model ProductVariant {
  id             String          @id @default(uuid())
  productId      String
  attribute      String
  value          String
  extraPrice     Int             @default(0)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotationLines QuotationLine[]

  @@unique([productId, attribute, value])
}

model Plan {
  id                 String              @id @default(uuid())
  name               String
  description        String?
  price              Int
  billingInterval    String
  minQuantity        Int                 @default(1)
  startDate          DateTime            @default(now())
  endDate            DateTime?
  autoClose          Boolean             @default(false)
  closable           Boolean             @default(true)
  pausable           Boolean             @default(true)
  renewable          Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  subscriptions      Subscription[]
  quotationTemplates QuotationTemplate[]

  @@index([startDate])
}

model QuotationTemplate {
  id          String          @id @default(uuid())
  name        String
  description String?
  validDays   Int             @default(30)
  planId      String?
  plan        Plan?           @relation(fields: [planId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  lines       QuotationLine[]
}

model QuotationLine {
  id               String          @id @default(uuid())
  templateId       String
  productId        String?
  productVariantId String?
  quantity         Int             @default(1)
  unitPrice        Int             @default(0)
  taxCode          String?
  discountType     String?
  discountValue    Int?
  totalPrice       Int             @default(0)
  template         QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product          Product?        @relation(fields: [productId], references: [id])
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@index([templateId])
}

model Subscription {
  id                 String             @id @default(uuid())
  number             Int                @unique
  customerId         String
  planId             String
  startDate          DateTime
  expiryDate         DateTime?
  status             SubscriptionStatus @default(DRAFT)
  paymentTerms       Int
  nextBillingDate    DateTime?
  quotationExpiresAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  customer User               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan     Plan               @relation(fields: [planId], references: [id])
  lines    SubscriptionLine[]
  invoices Invoice[]

  @@index([customerId])
  @@index([status])
}

model SubscriptionLine {
  id               String       @id @default(uuid())
  subscriptionId   String
  productId        String?
  productVariantId String?
  quantity         Int
  unitPrice        Int
  discountAmount   Int          @default(0)
  taxAmount        Int          @default(0)
  totalAmount      Int
  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

model Tax {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  rate      Decimal
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([code])
}

model Discount {
  id          String    @id @default(uuid())
  code        String?   @unique
  name        String?
  type        String
  value       Int
  minPurchase Int       @default(0)
  minQuantity Int       @default(0)
  startDate   DateTime  @default(now())
  endDate     DateTime?
  usageLimit  Int?
  usedCount   Int       @default(0)
  appliesTo   String
  productId   String?
  product     Product?  @relation("product_discounts", fields: [productId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startDate])
}

model Invoice {
  id             String        @id @default(uuid())
  number         Int           @unique
  subscriptionId String
  status         InvoiceStatus @default(DRAFT)
  periodStart    DateTime      @default(now())
  periodEnd      DateTime      @default(now())
  dueDate        DateTime      @default(now())
  subtotal       Int
  discountTotal  Int           @default(0)
  taxTotal       Int           @default(0)
  total          Int
  sentAt         DateTime?
  lastReminderAt DateTime?
  reminderCount  Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subscription Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  lines        InvoiceLine[]
  payments     Payment[]

  @@unique([subscriptionId, periodStart])
  @@index([status])
  @@index([sentAt])
}

model InvoiceLine {
  id        String  @id @default(uuid())
  invoiceId String
  productId String?
  taxCode   String?
  quantity  Int
  unitPrice Int
  discount  Int     @default(0)
  tax       Int     @default(0)
  total     Int
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id             String   @id @default(uuid())
  invoiceId      String
  method         String
  amount         Int
  paidAt         DateTime
  note           String?
  recordedById   String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User    @relation(fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([paidAt])
}

model BillingRun {
  id        String    @id @default(uuid())
  startDate DateTime
  endDate   DateTime?
  stats     Json
  errors    Json
  createdAt DateTime  @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  entity      String
  entityId    String
  action      String
  details     Json
  performedBy String?
  performedAt DateTime @default(now())
  user        User?    @relation(fields: [performedBy], references: [id])

  @@index([entity, entityId])
}
